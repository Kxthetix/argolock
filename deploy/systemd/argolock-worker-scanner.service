[Unit]
Description=ARGOLOCK NET Celery Vulnerability Scanner Worker
After=network.target redis.service mongodb.service

[Service]
Type=simple
User=argolock
Group=argolock
WorkingDirectory=/opt/argolock/backend
EnvironmentFile=/opt/argolock/.env
ExecStart=/opt/argolock/backend/venv/bin/celery -A workers.celery_app worker -Q scanner -c 2 --loglevel=info -n scanner@%H
Restart=always
RestartSec=10
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
