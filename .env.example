# ArgoLock Environment Configuration
# Copy this to .env and fill in your values

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=ArgoLock
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
# Comma-separated list, or "*" for all origins (development only)
CORS_ORIGINS=*

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=argolock

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Options: openai | claude | ollama
AI_PROVIDER=openai

# OpenAI (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Claude (required if AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (required if AI_PROVIDER=ollama — runs locally, no key needed)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# ─── Tool Execution ───────────────────────────────────────────────────────────
# Options: docker | subprocess
# The bundled Dockerfile installs tool binaries directly, so "subprocess" is the
# default. Use "docker" only when the Docker socket is mounted into the container.
TOOL_EXECUTION_MODE=subprocess
TOOL_TIMEOUT_SECONDS=300

# Docker images for security tools (only used when TOOL_EXECUTION_MODE=docker)
NMAP_DOCKER_IMAGE=instrumentisto/nmap:latest
NUCLEI_DOCKER_IMAGE=projectdiscovery/nuclei:latest
NIKTO_DOCKER_IMAGE=frapsoft/nikto:latest
SQLMAP_DOCKER_IMAGE=paoloo/sqlmap:latest
SUBFINDER_DOCKER_IMAGE=projectdiscovery/subfinder:latest

# ─── OWASP ZAP ────────────────────────────────────────────────────────────────
# ZAP_API_KEY must match the api.key configured on the ZAP daemon (docker-compose).
ZAP_BASE_URL=http://zap:8080
ZAP_API_KEY=argolock-zap-key

# ─── Reports ──────────────────────────────────────────────────────────────────
REPORTS_DIR=/tmp/argolock_reports

# ─── Safety ───────────────────────────────────────────────────────────────────
SAFE_MODE=true
MAX_CONCURRENT_SCANS=3
RATE_LIMIT_PER_MINUTE=10

# ─── OAuth (optional) ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── OTP / Email (optional — if unset, OTP codes are logged to the console) ─────
OTP_EXPIRY_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
