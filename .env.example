# VaultX Environment Configuration
# Copy this to .env and fill in your values

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=vaultx

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Options: openai | claude | ollama
AI_PROVIDER=openai

# OpenAI (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Claude (required if AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (required if AI_PROVIDER=ollama — runs locally, no key needed)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# ─── Tool Execution ───────────────────────────────────────────────────────────
# Options: docker | subprocess
TOOL_EXECUTION_MODE=docker
TOOL_TIMEOUT_SECONDS=300

# Docker images for security tools
NMAP_DOCKER_IMAGE=instrumentisto/nmap:latest
NUCLEI_DOCKER_IMAGE=projectdiscovery/nuclei:latest
NIKTO_DOCKER_IMAGE=frapsoft/nikto:latest
SQLMAP_DOCKER_IMAGE=paoloo/sqlmap:latest
SUBFINDER_DOCKER_IMAGE=projectdiscovery/subfinder:latest

# ─── OWASP ZAP ────────────────────────────────────────────────────────────────
ZAP_BASE_URL=http://zap:8080
ZAP_API_KEY=vaultx-zap-key

# ─── Safety ───────────────────────────────────────────────────────────────────
SAFE_MODE=true
MAX_CONCURRENT_SCANS=3
